# Copy this file to .env and fill in real values. Never commit .env.

PORT=8787

# Long random string used to sign login sessions (openssl rand -hex 32)
JWT_SECRET=change-this-to-a-long-random-string

# Your site's URL(s), comma-separated, allowed to call this API
ALLOWED_ORIGINS=http://localhost:5500,https://your-site.example.com

# --- Anthropic (AI meal planner) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Flutterwave (cards AND mobile money — MTN MoMo, Orange Money, ---
# --- M-Pesa, Airtel Money, bank transfer — through one checkout)    ---
# Get your secret key at https://dashboard.flutterwave.com/settings/apis
FLW_SECRET_KEY=FLWSECK_TEST-...

# A secret string YOU invent (not generated by Flutterwave) — set the
# exact same value in the Flutterwave Dashboard under Settings > Webhooks,
# "Secret hash". This is how incoming webhook calls are verified as
# genuinely from Flutterwave.
FLW_WEBHOOK_HASH=change-this-to-a-long-random-string

# Currency to charge in. Set to XAF here because Cameroonian Flutterwave
# accounts currently settle only in XAF regardless of what currency a
# customer pays with (cards get auto-converted) — charging in XAF
# directly avoids paying a conversion spread on every sale. If that ever
# changes, or you're deploying this for a different country, USD works
# everywhere Flutterwave supports.
FLW_CURRENCY=XAF

# Prices — plain numbers, no currency symbol, in whatever FLW_CURRENCY is.
# These CFA franc amounts are roughly equivalent to the original
# $4.99 / $49.99 / $9.99 USD pricing, rounded to clean local numbers.
PLUS_AMOUNT_MONTH=3000
PLUS_AMOUNT_YEAR=30000
EBOOK_AMOUNT=6000

CHECKOUT_SUCCESS_URL=https://your-site.example.com/?upgraded=1
EBOOK_SUCCESS_URL=https://your-site.example.com/?ebook=1

# --- Password reset emails ---
# Your site's real address, used to build the link in reset emails
# (https://your-site.example.com/#reset=<token>). Falls back to
# localhost if left blank.
SITE_URL=https://your-site.example.com
# No email provider is wired up yet — reset links are logged to this
# server's console so you can test the flow. See sendResetEmail() in
# server.js for where to add a real provider (Resend, Postmark, SendGrid...).

# --- Error monitoring (optional) ---
# Leave blank to skip. With a DSN set (and `npm install @sentry/node`),
# server errors are reported to https://sentry.io automatically.
SENTRY_DSN=
